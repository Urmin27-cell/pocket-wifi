rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'boutiquemevasoa@gmail.com'
      );
    }

    // Products collection (public catalog for visitors, admin only for write)
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && isAdmin();
      allow update: if isValidId(productId) && isAdmin();
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(categoryId) && isAdmin();
    }

    // Site settings
    match /siteSettings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId) && isAdmin();
    }

    // Banners collection
    match /banners/{bannerId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(bannerId) && isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(orderId) &&
        incoming().customerName is string &&
        incoming().customerName.size() > 0 &&
        incoming().contactPhone is string &&
        incoming().contactPhone.size() > 0 &&
        incoming().quantity is number &&
        incoming().quantity > 0;
      allow update, delete: if isValidId(orderId) && isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Products collection (public catalog for visitors, manageable from admin)
    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read, write: if isValidId(categoryId);
    }

    // Site settings (general content, contact, whatsapp, security PIN)
    match /siteSettings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Banners collection
    match /banners/{bannerId} {
      allow read, write: if isValidId(bannerId);
    }

    // Orders collection (customer WhatsApp order log and admin management)
    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId);
    }
  }
}
